{
  "mcpServers": {
    "neo4j-vanuatu": {
      "command": "uvx",
      "args": ["mcp-neo4j-cypher@latest", "--transport", "stdio"],
      "env": {
        "NEO4J_URI": "neo4j://localhost:7687",
        "NEO4J_USERNAME": "reader",
        "NEO4J_PASSWORD": "REPLACE_ME",
        "NEO4J_DATABASE": "neo4j"
      }
    }
  }
}
